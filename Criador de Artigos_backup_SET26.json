      "parameters": {
        "jsCode": "const emailSolicitado = ($('Formulário de solicitação').item.json.email || '').trim().toLowerCase();\nconst usuarios = $json.data || [];\nconst usuarioEncontrado = usuarios.find(u => u.email && u.email.trim().toLowerCase() === emailSolicitado);\nreturn {\n  json: {\n    emailCadastrado: !!usuarioEncontrado,\n    emailSolicitado: emailSolicitado,\n    usuarioId: usuarioEncontrado ? usuarioEncontrado.id : null,\n    usuarioNome: usuarioEncontrado ? usuarioEncontrado.name : null\n  }\n};"
      },
